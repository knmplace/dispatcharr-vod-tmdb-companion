# Copy this file to `.env` next to your docker-compose.yml (the one with the
# vod-tmdb-companion service pasted in). docker compose reads .env
# automatically to fill in the ${VAR} references in that file -- this is a
# DIFFERENT mechanism than the `env_file:` line inside the service itself,
# which points at your Dispatcharr stack's own .env to inherit POSTGRES_*.
# Do not commit your real .env -- it's already covered by .gitignore.

# Path to your Dispatcharr stack's own .env file (supplies POSTGRES_HOST/
# PORT/DB/USER/PASSWORD automatically -- see docker-compose.example.yml).
DISPATCHARR_ENV_FILE=/etc/docker/dispatcharr/.env

# Host path for this tool's own persistent state (reconcile checkpoint,
# run state, pause flag, and settings.json). Follow the same
# /etc/docker/<tool>/ convention as the rest of your stack.
DATA_DIR=/etc/docker/tmdbtool

# Host port to expose the companion's dashboard on.
COMPANION_PORT=8686

# TMDB API key, dry-run/live mode, confidence threshold, worker threads,
# and row limits are NOT set here -- configure them from the dashboard
# (http://<host>:${COMPANION_PORT}/) after first boot. They persist to
# ${DATA_DIR}/settings.json, so changing them doesn't require editing this
# file or recreating the container.
