# Copy this file to `.env` next to your docker-compose.yml (the one with the
# vod-tmdb-companion service pasted in). docker compose reads .env
# automatically to fill in the ${VAR} references in that file.
# Do not commit your real .env -- it's already covered by .gitignore.

# --- Postgres ---
# Most Dispatcharr deployments are the all-in-one (AIO) image, which runs
# Postgres inside Dispatcharr's own container with NO exposed env vars and
# NO .env file -- its settings.py falls back to fixed internal defaults.
# Confirm your real values before trusting the ones below, e.g.:
#   docker exec <dispatcharr_container_name> python3 -c \
#     "import os,sys; sys.path.insert(0,'/app'); os.environ.setdefault('DJANGO_SETTINGS_MODULE','dispatcharr.settings'); import django; django.setup(); from django.conf import settings; print(settings.DATABASES['default'])"

# Your Dispatcharr container's NAME on the shared Docker network -- NOT
# "localhost" (that only resolves inside Dispatcharr's own container; this
# companion is a separate container and needs the real container name).
POSTGRES_HOST=dispatcharr

POSTGRES_PORT=5432
# AIO image defaults -- override if you changed these:
POSTGRES_DB=dispatcharr
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=secret

# Only needed if your Dispatcharr deployment is a split multi-container
# setup with its own real .env file Dispatcharr itself reads -- most AIO
# users should leave this unset. If used, also uncomment the `env_file:`
# line in docker-compose.example.yml and you can remove the POSTGRES_*
# lines above (env_file supplies them instead).
# DISPATCHARR_ENV_FILE=/etc/docker/dispatcharr/.env

# Host path for this tool's own persistent state (reconcile checkpoint,
# run state, pause flag, and settings.json). Follow the same
# /etc/docker/<tool>/ convention as the rest of your stack.
DATA_DIR=/etc/docker/tmdbtool

# Host port to expose the companion's dashboard on.
COMPANION_PORT=8686

# Timezone for log timestamps -- defaults to UTC if unset.
TZ=America/New_York

# TMDB API key, dry-run/live mode, confidence threshold, worker threads,
# and row limits are NOT set here -- configure them from the dashboard
# (http://<host>:${COMPANION_PORT}/) after first boot. They persist to
# ${DATA_DIR}/settings.json, so changing them doesn't require editing this
# file or recreating the container.
